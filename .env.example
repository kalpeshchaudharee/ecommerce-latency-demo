NODE_ENV=development
PORT=3000

# Local:
DATABASE_URL=postgresql://demo:demo@localhost:5432/ecommerce

# AWS:
# DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>:5432/ecommerce

AWS_REGION=ap-south-1
PAYMENT_FUNCTION_NAME=ecommerce-payment-service
USE_AWS_LAMBDA=false

# Controlled observability demo failure.
# The API switch is preferred for live demonstrations.
DEMO_DB_DELAY_MS=0

OTEL_SERVICE_NAME=ecommerce-web
OTEL_SERVICE_VERSION=1.0.0
OTEL_DEPLOYMENT_ENVIRONMENT=demo

# Optional direct OTLP configuration.
# Use the AWS-recommended CloudWatch/ADOT endpoint and authentication
# for your selected ingestion path.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
